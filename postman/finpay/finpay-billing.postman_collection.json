	"item": [
		{
			"name": "Inquiry",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const moment = require('moment');\r",
							"\r",
							"var userName = pm.globals.get(\"userName\");\r",
							"var password = pm.globals.get(\"userPass\");\r",
							"\r",
							"var bodyRaw = pm.request.body\r",
							"var obj = JSON.parse(bodyRaw)\r",
							"\r",
							"\r",
							"var date = Date.now()\r",
							"timestamp = moment().format(\"DD-MM-YYYY HH:mm:ss:Z\")\r",
							"\r",
							"\r",
							"var sha256Param = CryptoJS.SHA256(timestamp+password).toString()\r",
							"var signatureToParse = userName+\r",
							"                obj.productCode+\r",
							"                obj.channel+\r",
							"                obj.terminal+\r",
							"                obj.transactionType+\r",
							"                obj.billNumber+\r",
							"                date+\r",
							"                sha256Param\r",
							"\r",
							"var signature = CryptoJS.SHA256(signatureToParse).toString()\r",
							"\r",
							"pm.environment.set(\"userName\", userName)\r",
							"pm.environment.set(\"signature\", signature)\r",
							"pm.environment.set(\"timestamp\", timestamp)\r",
							"pm.environment.set(\"traxId\", date)\r",
							"\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
